# Porta da aplicação NestJS (alterada de 3000 para 3333 para não conflitar com o projeto roguefrog)
PORT=3333

# Modo do Banco de Dados:
# - true: Inicia automaticamente um servidor PostgreSQL 16 embutido (PGlite Socket) sem precisar instalar Docker
# - false: Conecta a um PostgreSQL externo (Docker Compose, Neon.tech, Supabase ou Postgres instalado na máquina)
USE_EMBEDDED_POSTGRES=true

# Configuração PostgreSQL (Usada tanto pelo MikroORM quanto pelo Docker Compose)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=junglegaming

# Opcional: URL completa de conexão (ex: Neon.tech ou Supabase).
# DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/junglegaming?sslmode=require
